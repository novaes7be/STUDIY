# Copie para .env (NÃO versione o .env) e configure as variáveis no IntelliJ/servidor.
# Perfil: dev (padrão) ou prod
# Em dev não precisa de nada. Em produção: SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/studiy
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# openssl rand -base64 48  (mínimo 32 caracteres)
JWT_SECRET=
# openssl rand -base64 32  (exatamente 32 bytes em Base64). PERDEU A CHAVE = PERDEU OS DADOS CIFRADOS.
STUDIY_ENCRYPTION_KEY=
# Domínios do front, separados por vírgula
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Opcional em dev (sem chave, a IA devolve respostas de teste)
ANTHROPIC_API_KEY=
