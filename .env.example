# Copie para .env (NÃO versione o .env) e configure as variáveis no IntelliJ/servidor.
# Perfil: dev (padrão) ou prod
# Em dev não precisa de nada. Em produção: SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_ACTIVE=dev

DB_URL=jdbc:postgresql://localhost:5432/studiy
DB_USER=postgres
DB_PASSWORD=troque-esta-senha

# openssl rand -base64 48  (mínimo 32 caracteres)
JWT_SECRET=
# openssl rand -base64 32  (exatamente 32 bytes em Base64). PERDEU A CHAVE = PERDEU OS DADOS CIFRADOS.
STUDIY_ENCRYPTION_KEY=
# Domínios do front, separados por vírgula
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Opcional em dev (sem chave, a IA devolve respostas de teste)
ANTHROPIC_API_KEY=

# ---- Pagamentos (Mercado Pago) ----
# Credenciais do app em mercadopago.com.br/developers (use as de TESTE até validar tudo)
MP_ACCESS_TOKEN=
# "Assinatura secreta" gerada ao configurar o webhook no painel do Mercado Pago
MP_WEBHOOK_SECRET=
# URL pública HTTPS da sua API, ex.: https://api.seudominio.com.br (em dev: túnel ngrok)
API_PUBLIC_URL=

# ---- E-mail de recuperação de senha (opcional em dev) ----
# URL pública do front (vai no link do e-mail). Obrigatória em prod.
FRONT_URL=http://localhost:5500
MAIL_FROM=
# SMTP (ex.: Brevo, Resend, Gmail com senha de app). Sem SPRING_MAIL_HOST o e-mail não é enviado.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# ---- Deploy (docker compose) ----
# Domínio público (o Caddy emite o HTTPS sozinho). Em produção: FRONT_URL=https://SEU_DOMINIO e CORS_ORIGINS=https://SEU_DOMINIO
DOMAIN=localhost
# true = só entra depois de confirmar o e-mail (exige SMTP configurado)
EXIGIR_VERIFICACAO_EMAIL=false
