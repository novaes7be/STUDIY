# HTTPS automático (Let's Encrypt) para o domínio em DOMAIN. Front e API na mesma origem.

# Domínios que só redirecionam (ex.: www.studiy.app -> studiy.app), com HTTPS próprio.
# REDIRECT_DOMAINS separado por espaço; REDIRECT_TO é a origem de destino, sem barra no fim.
{$REDIRECT_DOMAINS} {
	redir {$REDIRECT_TO}{uri} permanent
}

{$DOMAIN:localhost} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# Site fechado (SITE_FECHADO=1) enquanto não lança: o front pede usuário e senha e nada é indexado.
	# A API (/api/*, inclusive o webhook do Mercado Pago) fica de fora: tem login próprio.
	# SITE_SENHA_HASH vem de `caddy hash-password`. O padrão abaixo é o hash de uma senha aleatória
	# descartada: só existe para o arquivo ser válido com o site aberto, e nunca é usado.
	@fechado expression `{env.SITE_FECHADO} == "1"`
	header @fechado X-Robots-Tag "noindex, nofollow"

	handle /api/* {
		reverse_proxy api:8080
	}
	handle {
		basic_auth @fechado {
			{$SITE_USUARIO:studiy} {$SITE_SENHA_HASH:$2a$14$1Ni0SBIkKQbLWjz7gcdTw.VEGxHVXOB9twhA0aobM/puVVasO7hZe}
		}
		# Mesma política da <meta> gerada no build, agora como header (frame-ancestors só vale aqui).
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' {$API_ORIGIN}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		# Arquivos sem hash no nome: revalida sempre (ETag), para um deploy nunca servir CSS/JS velho
		header Cache-Control "no-cache"
		root * /srv
		file_server
	}
}
