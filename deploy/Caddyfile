# HTTPS automático (Let's Encrypt) para o domínio em DOMAIN. Front e API na mesma origem.
{$DOMAIN:localhost} {
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle {
		# Mesma política da <meta> gerada no build, agora como header (frame-ancestors só vale aqui).
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' {$API_ORIGIN}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		root * /srv
		file_server
	}
}
